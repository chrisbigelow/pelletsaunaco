# Stripe — https://dashboard.stripe.com/apikeys
# Server-only secret key, used by api/preorder.js
STRIPE_SECRET_KEY=sk_test_...
# Publishable key, baked into the page at build time
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Set to true in Vercel's Production environment to show the "X of 100 reserved" bars
# (around 20 orders), then redeploy. Unset: shown on previews, hidden in production.
SHOW_BATCH_PROGRESS=

# Resend — https://resend.com/api-keys (use a "Sending + Contacts" / full-access key)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Segment that holds the marketing email list (Resend → Audience → Segments).
# Broadcasts/campaigns are sent to this segment.
RESEND_SEGMENT_ID=dc3cf263-ae25-4711-9e9e-39b31b853e05

# Verified sending identity (domain must be verified in Resend → Domains)
EMAIL_FROM="The Pellet Sauna Co. <hello@pelletsauna.com>"
EMAIL_REPLY_TO=jared@pelletsauna.com

# Where contact-form submissions are delivered (comma-separated for several)
CONTACT_INBOX=jared@pelletsauna.com,someone@example.com
