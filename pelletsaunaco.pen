                          "children": [
                            {
                              "type": "text",
                              "id": "mCw5U",
                              "name": "How does the P1 pellet sauna stove work?",
                              "context": "h3",
                              "fill": "#1a1f22",
                              "content": "How does the P1 pellet sauna stove work?",
                              "lineHeight": 1.18,
                              "fontFamily": "Work Sans",
                              "fontSize": 20,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "cDLSw",
                              "name": "The P1 pellet sauna stove automatically ",
                              "context": "p",
                              "fill": "#4a5258",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 190.37,
                              "content": "The P1 pellet sauna stove automatically feeds wood pellets from a built-in hopper into a combustion chamber. An electronic control system manages the pellet feed rate to maintain your desired temperature, and the unit runs by plugging into a standard 110V outlet. You can even start your pellet sauna stove remotely using our app, so your sauna is hot when you arrive.",
                              "lineHeight": 1.7,
                              "fontFamily": "Work Sans",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
