                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 47,
                              "content": "What maintenance does a pellet sauna stove need?",
                              "fontFamily": "Work Sans",
                              "fontSize": 20,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "kmXXf",
                              "name": "Like other pellet appliances, a pellet s",
                              "context": "p",
                              "fill": "#4a5258",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 135.98,
                              "content": "Like other pellet appliances, a pellet sauna stove should be kept clean and inspected regularly. Owners should empty ash as needed, keep air pathways clear, use quality dry pellets, and follow the maintenance schedule in the product manual.",
                              "lineHeight": 1.7,
                              "fontFamily": "Work Sans",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
