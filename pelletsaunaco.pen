                    {
                      "type": "text",
                      "id": "iRV6e",
                      "name": "The P1 isn't just another sauna stove. I",
                      "context": "p",
                      "fill": "#4a5258",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 183.56,
                      "content": "The P1 isn't just another sauna stove. It's an entirely new way to sauna. It combines the soulful warmth of a wood-fired sauna with the effortless convenience of electric. Just plug it into a standard 110V outlet. No electricians, no woodpiles. Just a perfect Löyly every time.",
