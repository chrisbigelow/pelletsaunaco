                          "children": [
                            {
                              "type": "text",
                              "id": "yVUO1",
                              "name": "What is a pellet sauna stove?",
                              "context": "h3",
                              "fill": "#1a1f22",
                              "content": "What is a pellet sauna stove?",
                              "lineHeight": 1.18,
                              "fontFamily": "Work Sans",
                              "fontSize": 20,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "HlOwM",
                              "name": "A pellet sauna stove is an innovative sa",
                              "context": "p",
                              "fill": "#4a5258",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 163.17,
                              "content": "A pellet sauna stove is an innovative sauna heater that uses compressed wood pellets as fuel instead of traditional firewood or electricity. The P1 pellet sauna stove combines the authentic wood-fired sauna experience with modern convenience, offering precise temperature control and easy operation.",
                              "lineHeight": 1.7,
                              "fontFamily": "Work Sans",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "hZtze",
                          "name": "div",
