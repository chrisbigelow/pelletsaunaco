                              "context": "p",
                              "fill": "#4a5258",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 108.78,
                              "content": "Pellet use depends on room size, outside temperature, target temperature, insulation, and session length. Because pellets are compact and widely available, they are easy to store and restock compared with split firewood.",
                              "lineHeight": 1.7,
                              "fontFamily": "Work Sans",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
