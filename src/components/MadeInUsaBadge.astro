---
// Round "Made in the USA" seal. `light` is for dark backgrounds (hero, footer).
interface Props {
  size?: number;
  tone?: 'ink' | 'light';
  class?: string;
}

const { size = 84, tone = 'ink', class: className } = Astro.props;

// The arc needs an id, and a page can show more than one badge.
const arcId = `usa-arc-${Math.random().toString(36).slice(2, 8)}`;

// Three stars along the bottom of the ring.
const starPoints = (cx: number, cy: number, outer = 4.4, inner = 1.9) =>
  Array.from({ length: 10 }, (_, i) => {
    const radius = i % 2 === 0 ? outer : inner;
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + radius * Math.cos(angle)).toFixed(2)},${(cy + radius * Math.sin(angle)).toFixed(2)}`;
  }).join(' ');

const stars = [-20, 0, 20].map((degrees) => {
  const angle = (degrees * Math.PI) / 180;
  return starPoints(60 + 47.5 * Math.sin(angle), 60 + 47.5 * Math.cos(angle));
});
---

<svg
  class:list={['usa-badge', `usa-badge-${tone}`, className]}
  viewBox="0 0 120 120"
  width={size}
  height={size}
  role="img"
  aria-label="Made in the USA"
>
  <defs>
    <path id={arcId} d="M 17 60 a 43 43 0 0 1 86 0" />
  </defs>
  <circle class="usa-badge-fill" cx="60" cy="60" r="59" />
  <circle class="usa-badge-line" cx="60" cy="60" r="56.5" stroke-width="1.5" />
  <circle class="usa-badge-line" cx="60" cy="60" r="38.5" stroke-width="1" />
  <text class="usa-badge-arc">
    <textPath href={`#${arcId}`} startOffset="50%" text-anchor="middle">MADE IN THE</textPath>
  </text>
  <text class="usa-badge-usa" x="60" y="72.5" text-anchor="middle">USA</text>
  {stars.map((points) => <polygon class="usa-badge-star" points={points} />)}
</svg>

<style>
  .usa-badge {
    display: block;
    flex-shrink: 0;
  }

  .usa-badge-fill {
    fill: none;
  }

  .usa-badge-line {
    fill: none;
    stroke: var(--pine);
  }

  .usa-badge-arc,
  .usa-badge-usa {
    fill: var(--pine);
  }

  .usa-badge-arc {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.4px;
  }

  .usa-badge-usa {
    font-family: var(--serif);
    font-size: 36px;
  }

  .usa-badge-star {
    fill: var(--clay);
  }

  .usa-badge-light .usa-badge-fill {
    fill: rgba(30, 28, 20, 0.45);
  }

  .usa-badge-light .usa-badge-line {
    stroke: var(--cream);
  }

  .usa-badge-light .usa-badge-arc,
  .usa-badge-light .usa-badge-usa {
    fill: var(--cream);
  }
</style>
