---
import { guides, productPath } from '../lib/site';

interface Props {
  /** Path of the guide being viewed, left out of the list. */
  current: string;
}

const { current } = Astro.props;
const related = guides.filter((guide) => guide.href !== current);
---

<nav class="related-guides" aria-labelledby="related-guides-title">
  <h2 id="related-guides-title">Keep reading</h2>
  <ul>
    {related.map((guide) => (
      <li><a href={guide.href}>{guide.title}</a></li>
    ))}
    <li><a href={productPath}>P1 pellet sauna stove specs and pricing</a></li>
  </ul>
</nav>

<style>
  .related-guides {
    max-width: 720px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid rgba(43, 42, 34, 0.15);
  }

  h2 {
    margin-bottom: 14px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.15;
    color: var(--ink);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
  }

  a {
    color: var(--ink);
    font-size: 17px;
    line-height: 1.5;
    text-underline-offset: 3px;
  }
</style>
