---
import Icon from './Icon.astro';
import { aboutPath, logoPaths, productPath, socialLinks } from '../lib/site';

const socials = [
  { icon: 'instagram', label: 'Instagram', href: socialLinks.instagram },
  { icon: 'facebook', label: 'Facebook', href: socialLinks.facebook },
] as const;
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-lockup">
          <svg class="footer-mark" viewBox="428 232 430 788" aria-hidden="true" focusable="false">
            <g fill="currentColor">{logoPaths.map((d) => <path d={d} />)}</g>
          </svg>
          <p class="footer-name">The Pellet Sauna Company</p>
        </div>
        <ul class="footer-social">
          {socials.map((s) => (
            <li><a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={17} /></a></li>
          ))}
        </ul>
      </div>
      <form class="footer-signup" id="signupForm" method="POST" action="/api/subscribe" novalidate>
        <label for="signupEmail" class="footer-signup-label">Get P1 preorder &amp; build updates</label>
        <div class="footer-signup-row">
          <input type="email" id="signupEmail" name="email" placeholder="you@example.com" autocomplete="email" required />
          <button type="submit" class="btn btn-clay" id="signupBtn">Join</button>
        </div>
        <input type="text" name="company" style="display: none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="footer-signup-message" id="signupMessage" role="status"></p>
      </form>
      <div class="footer-links">
        <div class="footer-column">
          <h4>Product</h4>
          <a href={productPath}>P1 Stove</a>
          <a href="/#product">Features</a>
          <a href={`${productPath}#specifications`}>Specs</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href={aboutPath}>About Us</a>
          <a href="/#contact">Contact</a>
          <a href="/refund">Refunds</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 The Pellet Sauna Company. All rights reserved.</p>
    </div>
  </div>
  <img
    class="footer-art"
    src="/images/home/footer-landscape.jpg"
    alt=""
    width="1920"
    height="648"
    loading="lazy"
    decoding="async"
  />
</footer>

<script>
  const signupForm = document.getElementById('signupForm') as HTMLFormElement | null;
  const signupBtn = document.getElementById('signupBtn') as HTMLButtonElement | null;
  const signupMessage = document.getElementById('signupMessage');

  signupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!signupMessage) return;
    const emailInput = signupForm.elements.namedItem('email') as HTMLInputElement;
    if (!emailInput.checkValidity()) {
      signupMessage.textContent = 'Please enter a valid email address.';
      signupMessage.dataset.state = 'error';
      return;
    }
    if (signupBtn) signupBtn.disabled = true;
    signupMessage.textContent = '';

    try {
      const response = await fetch('/api/subscribe', { method: 'POST', body: new FormData(signupForm) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.error);
      signupMessage.textContent =
        data.status === 'already_subscribed' ? "You're already on the list. Thanks!" : "You're on the list. Check your inbox!";
      signupMessage.dataset.state = 'success';
      signupForm.reset();
    } catch (error) {
      signupMessage.textContent =
        error instanceof Error && error.message ? error.message : 'Something went wrong. Please try again.';
      signupMessage.dataset.state = 'error';
    } finally {
      if (signupBtn) signupBtn.disabled = false;
    }
  });
</script>

<style>
  .footer-signup {
    grid-area: signup;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 400px;
  }

  .footer-signup-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sand-light);
  }

  .footer-signup-row {
    display: flex;
  }

  .footer-signup-row input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font: inherit;
    font-size: 15px;
    color: var(--cream);
    background: rgba(246, 241, 231, 0.08);
    border: 1px solid rgba(246, 241, 231, 0.3);
    border-right: none;
    border-radius: 0;
  }

  .footer-signup-row input::placeholder {
    color: rgba(246, 241, 231, 0.55);
  }

  .footer-signup-row input:focus {
    outline: 2px solid var(--clay);
    outline-offset: -2px;
  }

  .footer-signup-row .btn {
    padding: 14px 22px;
  }

  .footer-signup-row .btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .footer-signup-message {
    min-height: 1.4em;
    font-size: 13px;
    color: var(--sand);
  }

  .footer-signup-message[data-state='error'] {
    color: #f0b49a;
  }

  .footer {
    position: relative;
    background: var(--pine);
    border-top: 1px solid rgba(246, 241, 231, 0.2);
    padding-top: 72px;
    overflow: hidden;
  }

  .footer-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 0 var(--gutter);
  }

  /* The illustration's empty sky sits behind the last 90px of footer text. */
  .footer-art {
    display: block;
    width: 100%;
    height: auto;
    margin-top: -90px;
  }

  /* Desktop: logo and socials | email signup | link columns, side by side. */
  .footer-top {
    display: grid;
    grid-template-columns: auto minmax(0, 400px) auto;
    grid-template-areas: 'brand signup links';
    justify-content: space-between;
    align-items: start;
    gap: 48px;
  }

  .footer-brand {
    grid-area: brand;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer-lockup {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-mark {
    width: 21.8px;
    height: 40px;
    flex-shrink: 0;
    color: var(--cream);
  }

  .footer-name {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--cream);
  }

  .footer-social {
    list-style: none;
    display: flex;
    gap: 10px;
  }

  .footer-social a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(246, 241, 231, 0.3);
    color: var(--cream);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .footer-social a:hover {
    background: rgba(246, 241, 231, 0.1);
    border-color: rgba(246, 241, 231, 0.6);
  }

  .footer-links {
    grid-area: links;
    display: flex;
    gap: 96px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-column h4 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sand-light);
  }

  .footer-column a {
    font-size: 15px;
    color: var(--sand-pale);
    text-decoration: none;
  }

  .footer-column a:hover {
    color: #fff;
  }

  .footer-bottom {
    padding-top: 28px;
    border-top: 1px solid rgba(246, 241, 231, 0.15);
  }

  .footer-bottom p {
    font-size: 13px;
    color: var(--sand);
  }

  /* Tablet: signup drops under the logo, links stay on the right. */
  @media (max-width: 1100px) {
    .footer-top {
      grid-template-columns: minmax(0, 400px) auto;
      grid-template-areas:
        'brand links'
        'signup links';
      row-gap: 32px;
    }

    .footer-links {
      gap: 64px;
    }
  }

  @media (max-width: 1024px) {
    .footer-art {
      margin-top: -40px;
    }
  }

  /* Phone: right-hand trees and sauna, cropped at the bottom */
  @media (max-width: 640px) {
    .footer {
      padding-top: 28px;
    }

    .footer-content {
      gap: 40px;
    }

    .footer-top {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'brand'
        'signup'
        'links';
      gap: 36px;
    }

    .footer-links {
      gap: 80px;
    }

    .footer-bottom p {
      font-size: 12px;
    }

    .footer-art {
      height: 300px;
      object-fit: cover;
      object-position: right top;
      margin: 4px 0 -26px;
    }
  }
</style>
