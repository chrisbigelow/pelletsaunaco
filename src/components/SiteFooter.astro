---
import Icon from './Icon.astro';
import { logoPaths, productPath } from '../lib/site';

// TODO: add profile URLs.
const socials = [
  { icon: 'instagram', label: 'Instagram', href: '#' },
  { icon: 'facebook', label: 'Facebook', href: '#' },
  { icon: 'youtube', label: 'YouTube', href: '#' },
] as const;
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-lockup">
          <svg class="footer-mark" viewBox="428 232 430 788" aria-hidden="true" focusable="false">
            <g fill="currentColor">{logoPaths.map((d) => <path d={d} />)}</g>
          </svg>
          <div>
            <p class="footer-name">The Pellet Sauna Company</p>
            <p class="footer-tagline">Effortless Wood-Fired Saunas</p>
          </div>
        </div>
        <ul class="footer-social">
          {socials.map((s) => (
            <li><a href={s.href} aria-label={s.label}><Icon name={s.icon} size={17} /></a></li>
          ))}
        </ul>
      </div>
      <div class="footer-links">
        <div class="footer-column">
          <h4>Product</h4>
          <a href={productPath}>P1 Stove</a>
          <a href="/#product">Features</a>
          <a href={`${productPath}#specifications`}>Specs</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/#about">About Us</a>
          <a href="/#contact">Contact</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 The Pellet Sauna Company. All rights reserved.</p>
    </div>
  </div>
  <img
    class="footer-art"
    src="/images/home/footer-landscape.jpg"
    alt=""
    width="1920"
    height="648"
    loading="lazy"
    decoding="async"
  />
</footer>

<style>
  .footer {
    position: relative;
    background: var(--pine);
    border-top: 1px solid rgba(246, 241, 231, 0.2);
    padding-top: 72px;
    overflow: hidden;
  }

  .footer-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding: 0 var(--gutter);
  }

  /* The illustration's empty sky sits behind the last 90px of footer text. */
  .footer-art {
    display: block;
    width: 100%;
    height: auto;
    margin-top: -90px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .footer-lockup {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-mark {
    width: 21.8px;
    height: 40px;
    flex-shrink: 0;
    color: var(--cream);
  }

  .footer-name {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--cream);
  }

  .footer-tagline {
    margin-top: 6px;
    font-size: 13px;
    color: var(--sand);
  }

  .footer-social {
    list-style: none;
    display: flex;
    gap: 10px;
  }

  .footer-social a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(246, 241, 231, 0.3);
    color: var(--cream);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .footer-social a:hover {
    background: rgba(246, 241, 231, 0.1);
    border-color: rgba(246, 241, 231, 0.6);
  }

  .footer-links {
    display: flex;
    gap: 120px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-column h4 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sand-light);
  }

  .footer-column a {
    font-size: 15px;
    color: var(--sand-pale);
    text-decoration: none;
  }

  .footer-column a:hover {
    color: #fff;
  }

  .footer-bottom {
    padding-top: 28px;
    border-top: 1px solid rgba(246, 241, 231, 0.15);
  }

  .footer-bottom p {
    font-size: 13px;
    color: var(--sand);
  }

  @media (max-width: 1024px) {
    .footer-art {
      margin-top: -40px;
    }
  }

  /* Phone: right-hand trees and sauna, cropped at the bottom */
  @media (max-width: 640px) {
    .footer {
      padding-top: 28px;
    }

    .footer-content {
      gap: 40px;
    }

    .footer-top {
      flex-direction: column;
      gap: 40px;
    }

    .footer-links {
      gap: 80px;
    }

    .footer-bottom p {
      font-size: 12px;
    }

    .footer-art {
      height: 300px;
      object-fit: cover;
      object-position: right top;
      margin: 4px 0 -26px;
    }
  }
</style>
