---
interface Props {
  title?: string;
  description?: string;
  siteUrl?: string;
}

const {
  title = 'P1 Pellet Sauna Stove | Wood Pellet Powered Sauna Heater',
  description = 'The P1 pellet sauna stove heats in 30 minutes. No electrician needed. Wood-fired warmth with modern convenience. The world\'s first pellet sauna stove.',
  siteUrl = Astro.site?.href || 'https://www.pelletsauna.com'
} = Astro.props;

const ogImage = new URL('/p1-stove3.webp', siteUrl).href;
const lcpImageHref = '/p1-stove3.webp';
const site = Astro.site ?? new URL('https://www.pelletsauna.com');
const canonicalURL = new URL(Astro.url.pathname, site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" as="image" href={lcpImageHref} fetchpriority="high" />
    <title>{title}</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="P1 Pellet Sauna Stove - The World's First Wood Pellet Sauna Stove" />
    <meta property="og:site_name" content="Pellet Sauna Company" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="P1 Pellet Sauna Stove - The World's First Wood Pellet Sauna Stove" />
    
    <!-- LinkedIn (uses Open Graph, but adding additional tags) -->
    <meta property="og:image:secure_url" content={ogImage} />
    
    <!-- Additional Meta Tags -->
    <meta name="author" content="Pellet Sauna Company" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playwrite+NO:wght@100..400&display=swap" rel="stylesheet">

    <!-- Structured Data - Organization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Pellet Sauna Company",
      "url": "https://www.pelletsauna.com",
      "logo": "https://www.pelletsauna.com/p1-stove3.webp",
      "description": "Manufacturer of the world's first wood pellet sauna stove. We combine traditional sauna warmth with modern pellet fuel convenience.",
      "sameAs": []
    }
    </script>

    <!-- Structured Data - WebPage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "P1 Pellet Sauna Stove",
      "url": "https://www.pelletsauna.com/",
      "description": "Landing page for the P1 Pellet Sauna Stove, the world's first wood pellet sauna stove. Learn about features like 30-minute heat-up time, standard 110V outlet operation, 300-500 cubic feet capacity, and built-in remote start.",
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://www.pelletsauna.com/p1-stove3.webp"
      }
    }
    </script>

    <!-- Structured Data - FAQPage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a pellet sauna stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pellet sauna stove is an innovative sauna heater that uses compressed wood pellets as fuel instead of traditional firewood or electricity. The P1 pellet sauna stove combines the authentic wood-fired sauna experience with modern convenience, offering precise temperature control and easy operation."
          }
        },
        {
          "@type": "Question",
          "name": "How does the P1 pellet sauna stove work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The P1 pellet sauna stove automatically feeds wood pellets from a built-in hopper into a combustion chamber. An electronic control system manages the pellet feed rate to maintain your desired temperature, and the unit runs by plugging into a standard 110V outlet. You can even start your pellet sauna stove remotely using our app, so your sauna is hot when you arrive."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose a pellet sauna stove over electric or wood-burning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pellet sauna stove offers the best of both worlds: the authentic warmth and ambiance of wood-fired heat without the hassle of chopping and storing firewood, and without the high electrical costs or installation requirements of electric heaters. Wood pellets are also more eco-friendly and cost-effective than other fuel sources."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to heat a sauna with a pellet stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The P1 pellet sauna stove heats your sauna to optimal temperature in approximately 30 minutes. This is comparable to electric heaters and faster than traditional wood-burning stoves, making it convenient for spontaneous sauna sessions."
          }
        },
        {
          "@type": "Question",
          "name": "What size sauna can the P1 pellet stove heat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The P1 pellet sauna stove is designed to efficiently heat saunas ranging from 300 to 500 cubic feet. This covers most residential sauna sizes, from compact home saunas to larger family-sized installations."
          }
        },
        {
          "@type": "Question",
          "name": "Are wood pellets easy to find for my pellet sauna stove?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Wood pellets are widely available at hardware stores, home improvement centers, and online retailers. They're the same pellets used in pellet grills and home heating systems, making them convenient and affordable to purchase year-round."
          }
        },
        {
          "@type": "Question",
          "name": "Does a pellet sauna stove need an electrician?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The P1 is designed to plug into a standard 110V outlet, avoiding the dedicated high-voltage electrical work commonly required for many electric sauna heaters. Always follow the installation manual and local code requirements for your sauna setup."
          }
        },
        {
          "@type": "Question",
          "name": "Can a pellet sauna stove be used in an outdoor sauna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The P1 is designed for residential sauna rooms from 300 to 500 cubic feet, including many backyard and cabin sauna installations, when installed with proper clearances, ventilation, and venting."
          }
        },
        {
          "@type": "Question",
          "name": "How many wood pellets does one sauna session use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pellet use depends on room size, outside temperature, target temperature, insulation, and session length. Because pellets are compact and widely available, they are easy to store and restock compared with split firewood."
          }
        },
        {
          "@type": "Question",
          "name": "What maintenance does a pellet sauna stove need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Like other pellet appliances, a pellet sauna stove should be kept clean and inspected regularly. Owners should empty ash as needed, keep air pathways clear, use quality dry pellets, and follow the maintenance schedule in the product manual."
          }
        },
        {
          "@type": "Question",
          "name": "Can I retrofit a pellet stove into an existing sauna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many existing sauna rooms in the 300 to 500 cubic foot range may be candidates for a P1 retrofit. Final fit depends on room volume, clearances, venting path, floor protection, and the existing heater location."
          }
        },
        {
          "@type": "Question",
          "name": "Why does remote start matter for a sauna heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Remote start lets you begin heating before you walk outside or arrive at the sauna. With the P1's approximately 30-minute heat-up time, that convenience can turn sauna use from a planned chore into a more spontaneous routine."
          }
        }
      ]
    }
    </script>
  </head>
  <body>
    <slot />

    <div id="cookie-banner" class="cookie-banner" hidden>
      <p>
        We use Google Analytics cookies to understand site traffic.
        See our <a href="/privacy">Privacy Policy</a>.
      </p>
      <div class="cookie-banner-actions">
        <button type="button" id="cookie-reject" class="cookie-btn cookie-btn-reject">Reject</button>
        <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">Accept</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var GA_ID = 'G-XHQWDSNJWF';
        var KEY = 'analytics-consent';

        function loadAnalytics() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }

        function setConsent(value) {
          try { localStorage.setItem(KEY, value); } catch (e) {}
          var banner = document.getElementById('cookie-banner');
          if (banner) banner.hidden = true;
          if (value === 'accepted') loadAnalytics();
        }

        var consent = null;
        try { consent = localStorage.getItem(KEY); } catch (e) {}

        if (consent === 'accepted') {
          loadAnalytics();
        } else if (consent !== 'rejected') {
          var banner = document.getElementById('cookie-banner');
          if (banner) banner.hidden = false;
        }

        document.getElementById('cookie-accept')?.addEventListener('click', function () {
          setConsent('accepted');
        });
        document.getElementById('cookie-reject')?.addEventListener('click', function () {
          setConsent('rejected');
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Natural wood tones - inspired by sauna wood */
    --wood-natural: #d4a574;
    --wood-light: #e8d5c4;
    --wood-medium: #c89968;
    --wood-warm: #b88a5c;

    /* Blue-gray atmospheric tones */
    --sky-light: #a8b8c4;
    --sky-medium: #8fa3b0;
    --sky-blue: #6b8a9d;
    --mist: #d1dce5;
    --mist-light: #e8eef2;

    /* Sauna stove colors */
    --stove-dark: #3a4145;
    --stove-charcoal: #2d3235;
    --fire-glow: #ff6b4a;
    --fire-orange: #ff8c61;
    --steam-white: #f8fbfd;

    /* Neutrals */
    --white: #ffffff;
    --off-white: #fafcfd;
    --light-gray: #e5eaed;
    --text-dark: #1a1f22;
    --text-medium: #4a5258;

    /* Accent colors */
    --accent-warm: #d4915c;
    --accent-cool: #7a9bb0;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Work Sans', sans-serif;
    background-color: var(--off-white);
    color: var(--text-dark);
    overflow-x: hidden;
  }

  html {
    scroll-behavior: smooth;
  }

  .cookie-banner {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    background: var(--stove-charcoal);
    color: var(--steam-white);
    font-size: 0.875rem;
    line-height: 1.45;
    box-shadow: 0 8px 24px rgba(26, 31, 34, 0.2);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    flex: 1 1 14rem;
    margin: 0;
  }

  .cookie-banner a {
    color: var(--wood-light);
    text-underline-offset: 2px;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.5rem 0.9rem;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .cookie-btn-accept {
    background: var(--wood-natural);
    color: var(--text-dark);
  }

  .cookie-btn-reject {
    background: transparent;
    color: var(--steam-white);
    border-color: rgba(248, 251, 253, 0.35);
  }
</style>
