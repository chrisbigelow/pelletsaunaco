---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/theme.css';

const team = [
  {
    name: 'Jared',
    role: 'Cofounder, Head of Engineering',
    photo: { src: '/images/about/jared.jpg', alt: 'Jared and his family sitting in front of a P1 pellet sauna stove in a cedar sauna wall', width: 900, height: 1200 },
    bio: [
      'Jared studied mechanical engineering at North Dakota State University, focusing on composite materials and lightweight design. After internships at TEAM and Polaris Inc., he joined the Polaris engineering development program and worked as a project, manufacturing, systems, and design engineer, most recently as a head vehicle architect for heavy land vehicles.',
      'Somewhere along the way he fell hard for sauna, and for the stoves that make it. The P1 is the stove he always wanted for his own backyard: real fire, steady heat, and none of the babysitting.',
    ],
  },
  {
    name: 'Chris',
    role: 'Cofounder, Head of Electronics and Software',
    photo: { src: '/images/about/chris.jpg', alt: 'Chris smiling in a towel in front of a snow-covered barrel sauna at night', width: 900, height: 1200 },
    bio: [
      'Chris’s background is in software, including his time at Google. He builds the digital side of the P1: the app that lets you start your stove from your phone, the controls that hold your temperature steady, and this website.',
      'His favorite session is a winter night: a hot room, a roll in the snow, and back in for another round. He wants every P1 owner to get there with a single tap.',
    ],
  },
];
---

<BaseLayout
  title="About Us | The Pellet Sauna Company"
  description="The Pellet Sauna Company makes the P1, the world's first wood pellet sauna stove, built to honor the traditional sauna ritual with modern convenience."
>
  <SiteNav solid variant="about" />

  <main class="about">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">About Us</li>
      </ol>
    </nav>

    <!-- Team -->
    <section class="team">
      <div class="team-head">
        <p class="eyebrow">The team</p>
        <h1 class="section-title">The people behind the P1</h1>
        <p class="team-intro">
          We grew up together in Minnesota, in saunas long before we thought about building for them. The P1 is the stove we wanted and couldn’t find.
        </p>
      </div>
      <div class="team-grid">
        {team.map((person) => (
          <article class="team-member">
            <img src={person.photo.src} alt={person.photo.alt} width={person.photo.width} height={person.photo.height} loading="lazy" decoding="async" />
            <div class="team-copy">
              <h3>{person.name}</h3>
              <p class="team-role">{person.role}</p>
              {person.bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .about {
    padding-top: 65px;
  }

  /* Breadcrumb (matches the P1 product page) */
  .breadcrumb {
    padding: 28px var(--gutter);
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 12px;
    color: var(--stone);
  }

  .breadcrumb a {
    color: #8a8575;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--ink);
  }

  .team {
    background: var(--linen);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .team-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .team-intro {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .team-member img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .team-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .team-copy h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.1;
    color: var(--ink);
  }

  .team-role {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--clay);
  }

  .team-copy p:not(.team-role) {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (min-width: 1201px) {
    .breadcrumb,
    .team {
      --gutter: max(96px, calc((100vw - 1088px) / 2));
    }
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 72px;
    }

    .team-member img {
      max-width: 480px;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding-top: 60px;
    }

    .breadcrumb {
      padding-top: 20px;
      padding-bottom: 20px;
    }
  }
</style>
