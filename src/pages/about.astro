---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/theme.css';

const team = [
  {
    name: 'Jared',
    role: 'Cofounder, Head of Engineering',
    photo: { src: '/images/about/jared.jpg', alt: 'Jared and his family sitting in front of a P1 pellet sauna stove in a cedar sauna wall', width: 900, height: 1200 },
    bio: [
      'Jared studied mechanical engineering at North Dakota State University, focusing on composite materials and lightweight design. After internships at TEAM and Polaris Inc., he joined the Polaris engineering development program and worked as a project, manufacturing, systems, and design engineer, most recently as a head vehicle architect for heavy land vehicles.',
      'Somewhere along the way he fell hard for sauna, and for the stoves that make it. The P1 is the stove he always wanted for his own backyard: real fire, steady heat, and none of the babysitting.',
    ],
  },
  {
    name: 'Chris',
    role: 'Cofounder, Head of Electronics and Software',
    photo: { src: '/images/about/chris.jpg', alt: 'Chris smiling in a towel in front of a snow-covered barrel sauna at night', width: 900, height: 1200 },
    bio: [
      'Chris is the software guy with a serious sauna habit. He builds the digital side of the P1 — the app that lets you start your stove from your phone, the controls that hold your temperature steady, and this website.',
      'His favorite session is a winter night: a hot room, a roll in the snow, and back in for another round. He wants every P1 owner to get there with a single tap.',
    ],
  },
];
---

<BaseLayout
  title="About Us | The Pellet Sauna Company"
  description="The Pellet Sauna Company makes the P1, the world's first wood pellet sauna stove — built to honor the traditional sauna ritual with modern convenience."
>
  <SiteNav solid variant="about" />

  <main class="about">
    <!-- Hero -->
    <section class="about-hero">
      <img class="about-hero-bg" src="/images/home/pellet-pour.jpg" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
      <p class="eyebrow">About us</p>
      <h1>The Pellet Sauna Company</h1>
      <blockquote class="about-quote">
        “The best sauna experiences come from a harmony of tradition and innovation.”
      </blockquote>
    </section>

    <!-- Team -->
    <section class="team">
      <div class="team-head">
        <p class="eyebrow">The team</p>
        <h2 class="section-title">The people behind the P1</h2>
        <p class="team-intro">
          Jared and Chris grew up together in Minnesota, where sauna is a way of life. The P1 brings Jared’s mechanical engineering and Chris’s electronics and software together in one stove.
        </p>
      </div>
      <div class="team-grid">
        {team.map((person) => (
          <article class="team-member">
            <img src={person.photo.src} alt={person.photo.alt} width={person.photo.width} height={person.photo.height} loading="lazy" decoding="async" />
            <div class="team-copy">
              <h3>{person.name}</h3>
              <p class="team-role">{person.role}</p>
              {person.bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .about {
    padding-top: 65px;
  }

  .about-hero {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    background: var(--char);
    padding: 96px var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .about-hero > :not(.about-hero-bg) {
    position: relative;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.5);
  }

  .about-hero .eyebrow {
    color: var(--sand-pale);
  }

  .about-hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--cream-bright);
  }

  .about-quote {
    max-width: 760px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    line-height: 1.3;
    color: #f8f3ea;
  }

  .team {
    background: var(--linen);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .team-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .team-intro {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .team-member img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .team-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .team-copy h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.1;
    color: var(--ink);
  }

  .team-role {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--clay);
  }

  .team-copy p:not(.team-role) {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (min-width: 1201px) {
    .about-hero,
    .team {
      --gutter: max(96px, calc((100vw - 1088px) / 2));
    }
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 72px;
    }

    .team-member img {
      max-width: 480px;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding-top: 60px;
    }

    .about-hero {
      min-height: 420px;
      padding: 72px var(--gutter);
    }
  }
</style>
