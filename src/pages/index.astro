<script>
  // Show only the poster for reduced-motion users and data-saver connections.
  const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (heroVideo && (window.matchMedia('(prefers-reduced-motion: reduce)').matches || connection?.saveData)) {
    heroVideo.removeAttribute('autoplay');
    heroVideo.pause();
    heroVideo.preload = 'none';
  }

  // Half speed: real-time flames read as busy, slower ones as calm.
  if (heroVideo) {
    const slowDown = () => {
      heroVideo.defaultPlaybackRate = 0.5;
      heroVideo.playbackRate = 0.5;
    };
    slowDown();
    heroVideo.addEventListener('loadedmetadata', slowDown);
  }

  // Contact form submission
  const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submitLabel');
  const formMessage = document.getElementById('formMessage');

  // Links from the product page pass ?subject=… to pre-fill the form (e.g. pre-order reservations).
  const presetSubject = new URLSearchParams(window.location.search).get('subject');
  const subjectInput = document.getElementById('form_subject') as HTMLInputElement | null;
  if (presetSubject && subjectInput) subjectInput.value = presetSubject.slice(0, 120);

  const showMessage = (text: string, type: 'success' | 'error') => {
    if (!formMessage) return;
    formMessage.textContent = text;
    formMessage.className = `form-message ${type}`;
    formMessage.style.display = 'block';
  };

  const setSubmitting = (submitting: boolean) => {
    if (submitBtn) submitBtn.disabled = submitting;
    if (submitLabel) submitLabel.textContent = submitting ? 'Sending...' : 'Send Message';
  };

  // Inline validation: each error stays under its field until that field is fixed.
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const fieldChecks: [string, (value: string) => string][] = [
    ['name', (value) => (value ? '' : 'Please enter your name.')],
    ['email', (value) => (!value ? 'Please enter your email.' : emailPattern.test(value) ? '' : 'Please enter a valid email address.')],
    ['message', (value) => (value ? '' : 'Please enter a message.')],
  ];
  let attemptedSubmit = false;

  const validateField = ([id, check]: (typeof fieldChecks)[number]) => {
    const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    const error = document.getElementById(`${id}-error`);
    if (!input || !error) return true;
    const message = check(input.value.trim());
    error.textContent = message;
    error.hidden = !message;
    input.setAttribute('aria-invalid', String(Boolean(message)));
    return !message;
  };

  const clearErrors = () => {
    attemptedSubmit = false;
    fieldChecks.forEach(([id]) => {
      document.getElementById(id)?.removeAttribute('aria-invalid');
      const error = document.getElementById(`${id}-error`);
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    });
  };

  fieldChecks.forEach((field) =>
    document.getElementById(field[0])?.addEventListener('input', () => {
      if (attemptedSubmit) validateField(field);
    })
  );

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    attemptedSubmit = true;
    const invalid = fieldChecks.filter((field) => !validateField(field));
    if (invalid.length) {
      document.getElementById(invalid[0][0])?.focus();
      return;
    }
    setSubmitting(true);
    if (formMessage) formMessage.style.display = 'none';

    try {
      const formData = new FormData(contactForm);

      // Spam protection: Check honeypot field
      if (formData.get('botcheck')) {
        showMessage('Spam detected. If you are human, please try again.', 'error');
        return;
      }

      const response = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      const data = await response.json().catch(() => ({}));

      if (response.ok && data.ok) {
        showMessage('Thank you! Your message has been sent successfully.', 'success');
        contactForm.reset();
        clearErrors();
      } else {
        throw new Error(data.error || 'Something went wrong');
      }
    } catch (error) {
      showMessage('Sorry, there was an error sending your message. Please try again or contact us directly.', 'error');
    } finally {
      setSubmitting(false);
    }
  });
</script>
