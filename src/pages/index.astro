---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CompareTable from '../components/CompareTable.astro';
import RitualSection from '../components/RitualSection.astro';
import InfoTip from '../components/InfoTip.astro';
import MadeInUsaBadge from '../components/MadeInUsaBadge.astro';
import { productPath } from '../lib/site';
import '../styles/theme.css';

const heroStats = [
  { value: '40 min', label: 'Heatup time', note: 'Measured from 17°C (63°F) to 80°C (176°F) in a 300 ft³ (8.5 m³) sauna.' },
  { value: 'up to 500 ft³', label: 'Hot room size' },
  { value: 'Remote Start', label: 'Built in' },
];

const pillars = [
  {
    icon: 'thermometer',
    title: 'Precise Temperature Control',
    body: 'Advanced fuel management for optimal heat. Start the stove remotely and set it to your exact temp using our app.',
  },
  { icon: 'leaf', title: 'Eco-Friendly Fuel', body: 'Sustainable wood pellets burn cleaner and cheaper' },
  { icon: 'zap', title: 'Efficient Performance', body: 'Quick heat-up time, small footprint' },
] as const;

// Must stay in sync with the FAQPage schema in BaseLayout.astro.
const faqs = [
  ['What is a pellet sauna stove?', 'A pellet sauna stove is an innovative sauna heater that uses compressed wood pellets as fuel instead of traditional firewood or electricity. The P1 pellet sauna stove combines the authentic wood-fired sauna experience with modern convenience, offering precise temperature control and easy operation.'],
  ['Why choose a pellet sauna stove over electric or wood-burning?', 'A pellet sauna stove offers the best of both worlds: the authentic warmth and ambiance of wood-fired heat without the hassle of chopping and storing firewood, and without the high electrical costs or installation requirements of electric heaters. Wood pellets are also more eco-friendly and cost-effective than other fuel sources.'],
  ['How long does it take to heat a sauna with a pellet stove?', 'The P1 pellet sauna stove heats your sauna to optimal temperature in approximately 40 minutes (measured from 63°F (17°C) to 176°F (80°C) in a 300 cubic foot (8.5 m³) sauna). This is comparable to electric heaters and faster than traditional wood-burning stoves, making it convenient for spontaneous sauna sessions.'],
  ['What size sauna can the P1 pellet stove heat?', 'The P1 pellet sauna stove is designed to efficiently heat saunas ranging from 210 to 500 cubic feet. This covers most residential sauna sizes, from compact home saunas to larger family-sized installations.'],
  ['Are wood pellets easy to find for my pellet sauna stove?', "Yes! Wood pellets are widely available at hardware stores, home improvement centers, and online retailers. They're the same pellets used in pellet grills and home heating systems, making them convenient and affordable to purchase year-round."],
  ['Does a pellet sauna stove need an electrician?', 'The P1 is designed to plug into a standard 110V outlet, avoiding the dedicated high-voltage electrical work commonly required for many electric sauna heaters. Always follow the installation manual and local code requirements for your sauna setup.'],
  ['Can a pellet sauna stove be used in an outdoor sauna?', 'Yes. The P1 is designed for residential sauna rooms from 210 to 500 cubic feet, including many backyard and cabin sauna installations, when installed with proper clearances, ventilation, and venting.'],
  ['How many wood pellets does one sauna session use?', 'Pellet use depends on room size, outside temperature, target temperature, insulation, and session length. Because pellets are compact and widely available, they are easy to store and restock compared with split firewood.'],
  ['What maintenance does a pellet sauna stove need?', 'Like other pellet appliances, a pellet sauna stove should be kept clean and inspected regularly. Owners should empty ash as needed, keep air pathways clear, use quality dry pellets, and follow the maintenance schedule in the product manual.'],
  ['Can I retrofit a pellet stove into an existing sauna?', 'Many existing sauna rooms in the 210 to 500 cubic foot range may be candidates for a P1 retrofit. Final fit depends on room volume, clearances, venting path, floor protection, and the existing heater location.'],
  ['What kind of exhaust venting does the P1 use?', 'The P1 uses standard pellet vent pipe for its exhaust, the same venting used by home pellet stoves, so pipe and fittings are easy to find at hardware stores and stove shops. Install venting according to the installation manual and local code.'],
  ['Why does remote start matter for a sauna heater?', "Remote start lets you begin heating before you walk outside or arrive at the sauna. With the P1's approximately 40-minute heat-up time, that convenience can turn sauna use from a planned chore into a more spontaneous routine."],
];

const contactDetails = [
  { icon: 'phone', label: 'Call us', value: '(720) 772-1574', href: 'tel:+17207721574' },
  { icon: 'mail', label: 'Email', value: 'jared@pelletsauna.com', href: 'mailto:jared@pelletsauna.com' },
] as const;
---

<BaseLayout isHome={true} lcpImage="/images/home/hero-poster.jpg">
  <SiteNav variant="home" />

  <!-- Hero -->
  <section class="hero" id="home">
    <video
      class="hero-video"
      id="heroVideo"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/home/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/p1-hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrims" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-copy">
        <h1 class="hero-title">The World’s First<br />Wood Pellet<br />Sauna Stove</h1>
        <p class="hero-sub">
          The P1 isn't just another sauna stove. It's an entirely new way to sauna. It combines the soulful warmth of a wood-fired sauna with the effortless convenience of electric. Just plug it into a standard 110V outlet. No electricians, no woodpiles. Just a perfect Löyly every time.
        </p>
        <div class="hero-cta">
          <a href={productPath} class="btn btn-clay">Explore the P1 <Icon name="arrow-right" size={16} /></a>
          <a href="#contact" class="btn btn-outline-light"><span class="hero-contact-desktop">Get in Touch</span><span class="hero-contact-mobile">Pre Order Now</span></a>
        </div>
      </div>

      <div class="hero-stats-wrap">
        <dl class="hero-stats">
          {heroStats.map((stat) => (
            <div class="hero-stat">
              <dt>{stat.label}</dt>
              <dd>{stat.value}{'note' in stat && <InfoTip text={stat.note} label="About heat-up time" tone="light" />}</dd>
            </div>
          ))}
        </dl>
        <div class="hero-badge"><MadeInUsaBadge size={84} tone="light" /></div>
      </div>
    </div>
  </section>

  <!-- Intro pillars -->
  <section class="pillars" id="product">
    <div class="pillars-head">
      <h2>A Better Experience In Every Way</h2>
      <p>The P1 delivers consistent, controllable warmth using clean-burning wood pellets. Designed for modern saunas, built to last a lifetime.</p>
    </div>
    <ul class="pillar-list">
      {pillars.map((pillar) => (
        <li class="pillar">
          <Icon name={pillar.icon} size={28} class="pillar-icon" />
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <CompareTable />

  <RitualSection
    tone="linen"
    photo={{ src: '/images/p1/ld-hopper-carry.jpg', alt: 'Carrying a bucket of pellets to the P1 hopper outside the sauna', width: 1800, height: 1200, position: '62% center' }}
  />


  <!-- Story -->
  <section class="story" id="about">
    <img class="story-bg" src="/images/home/pellet-pour.jpg" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <h2 class="story-eyebrow">The Pellet Sauna Company</h2>
    <blockquote class="story-quote">
      “The best sauna experiences come from a harmony of tradition and innovation.”
    </blockquote>
    <p class="story-body">
      The P1 embodies our commitment to crafting sauna stoves that honor the environment and the timeless sauna ritual. Each stove is engineered for performance, designed for beauty, and built to endure for generations.
    </p>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="faq-head">
      <p class="eyebrow faq-eyebrow">FAQ</p>
      <h2 class="section-title">Frequently Asked<br />Questions</h2>
      <p>Everything you need to know about the P1 Pellet Sauna Stove</p>
      <div class="faq-art" aria-hidden="true">
        <img src="/images/home/sauna-arch.jpg" alt="" width="900" height="856" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer], i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <h3>{question}</h3>
            <span class="faq-toggle">
              <Icon name="plus" size={20} class="faq-toggle-plus" />
              <Icon name="minus" size={20} class="faq-toggle-minus" />
            </span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="contact-copy">
      <p class="eyebrow">Contact Us</p>
      <h2>Get in Touch</h2>
      <p class="contact-sub">Preorders are opening soon. <em>We typically reply within 2 to 5 business days.</em></p>
      <p class="contact-sub">
        Reach out and join our growing email list to stay up to date as we bring the P1 Pellet Stove to production in mid-2027.
      </p>
    </div>

    <form class="contact-form" id="contactForm" method="POST" action="/api/contact" novalidate>
      <!-- Honeypot field for spam protection - hidden from users but bots will fill it -->
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

      <div id="formMessage" class="form-message" role="status" style="display: none;"></div>

      <div class="form-row">
        <div class="form-group">
          <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
          <p class="field-error" id="name-error" aria-live="polite" hidden></p>
        </div>
        <div class="form-group">
          <label for="email">Your email <span class="req" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-error" />
          <p class="field-error" id="email-error" aria-live="polite" hidden></p>
        </div>
      </div>
      <div class="form-group">
        <label for="form_subject">Subject</label>
        <input type="text" id="form_subject" name="form_subject" placeholder="What can we help with?" />
      </div>
      <div class="form-group">
        <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="5" placeholder="Tell us about your project or ask us a question…" required aria-describedby="message-error"></textarea>
        <p class="field-error" id="message-error" aria-live="polite" hidden></p>
      </div>
      <label class="form-check">
        <input type="checkbox" name="newsletter" checked />
        <span>Add me to the email list for P1 preorder and production updates. Unsubscribe anytime.</span>
      </label>
      <button type="submit" class="btn btn-clay btn-submit" id="submitBtn">
        <span id="submitLabel">Send Message</span>
        <Icon name="arrow-right" size={16} />
      </button>
    </form>

    <div class="contact-info">
      <ul class="contact-details">
        {contactDetails.map((item) => (
          <li>
            <span class="contact-icon"><Icon name={item.icon} size={18} /></span>
            <div>
              <span class="contact-label">{item.label}</span>
              {'href' in item ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: clamp(680px, 100svh, 960px);
    overflow: hidden;
    background: var(--char);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 40px 140px;
  }

  /* The video starts at the very top, behind the see-through nav, and the scrim fades it in. */
  .hero-video {
    position: absolute;
    top: 0;
    left: 70px;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0% center;
    /* Fades the video's left edge into the dark base. */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.3) 8%, #000 22%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.3) 8%, #000 22%);
  }

  .hero-scrims {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(30, 28, 20, 0.85) 0%, rgba(30, 28, 20, 0.45) 8%, rgba(30, 28, 20, 0) 22%, rgba(30, 28, 20, 0) 62%, rgba(30, 28, 20, 0.8) 100%),
      linear-gradient(to right, rgba(30, 28, 20, 0.95) 0%, rgba(30, 28, 20, 0.82) 30%, rgba(30, 28, 20, 0) 46%),
      linear-gradient(to left, rgba(30, 28, 20, 0.9) 0%, rgba(30, 28, 20, 0.65) 18%, rgba(30, 28, 20, 0) 32%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    padding: 0 16px;
  }

  .hero-copy {
    width: 460px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -1.5px;
    color: var(--cream-bright);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-sub {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.55;
    color: #f8f3ea;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
  }

  .hero-stats-wrap {
    width: 240px;
  }

  .hero-badge {
    margin-top: 16px;
  }

  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 8px;
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(246, 241, 231, 0.4);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-stat dd {
    font-family: var(--serif);
    font-size: 32px;
    color: var(--cream-bright);
  }

  .hero-stat dt {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sand-pale);
  }

  /* Intro pillars */
  .pillars {
    background: var(--pine);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
  }

  .pillars-head {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .pillars-head h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1.12;
    color: var(--cream);
  }

  .pillars-head p {
    max-width: 620px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--sand);
  }

  .pillar-list {
    list-style: none;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 8px 40px;
    text-align: center;
  }

  .pillar + .pillar {
    border-left: 1px solid rgba(246, 241, 231, 0.2);
  }

  .pillar :global(.pillar-icon) {
    color: var(--sand-light);
  }

  .pillar h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 24px;
    color: var(--cream);
  }

  .pillar p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--sand);
  }

  /* Story */
  .story {
    position: relative;
    overflow: hidden;
    min-height: 620px;
    background: var(--char);
    padding: 96px 160px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .story-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.24;
  }

  .story > :not(.story-bg) {
    position: relative;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.5);
  }

  .story-eyebrow {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sand-pale);
  }

  .story-quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1.15;
    color: var(--cream-bright);
  }

  .story-body {
    max-width: 720px;
    font-size: 16px;
    line-height: 1.6;
    color: #f8f3ea;
  }

  /* FAQ */
  .faq {
    background: var(--cream);
    padding: var(--section-y) var(--gutter);
    display: flex;
    align-items: flex-start;
    gap: 96px;
  }

  .faq-head {
    flex: 0 0 380px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .faq-head .section-title {
    font-size: clamp(2.25rem, 3.6vw, 2.75rem);
    line-height: 1.1;
  }

  .faq-head > p:not(.eyebrow) {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .faq-art {
    position: relative;
    width: 376px;
    height: 404px;
    max-width: 100%;
  }

  .faq-art img {
    width: 340px;
    height: 380px;
    object-fit: cover;
    border-radius: 170px 170px 14px 14px;
    border: 6px solid var(--cream);
    box-sizing: content-box;
    margin: -6px;
    transform: rotate(-2deg);
    transform-origin: top left;
    box-shadow: 0 8px 24px rgba(43, 42, 34, 0.15);
  }

  .faq-list {
    flex: 1;
    min-width: 0;
  }

  .faq-item {
    border-top: 1px solid rgba(43, 42, 34, 0.15);
    padding: 22px 0;
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.3;
    color: var(--ink);
  }

  .faq-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .faq-item :global(.faq-toggle-minus),
  .faq-item[open] :global(.faq-toggle-plus) {
    display: none;
  }

  .faq-item[open] :global(.faq-toggle-minus) {
    display: block;
  }

  .faq-item p {
    max-width: 680px;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Mobile-only FAQ extras (shown in the 640px breakpoint). */
  .hero-contact-mobile,
  .faq-eyebrow {
    display: none;
  }

  /* Contact */
  .contact {
    background: var(--char);
    padding: var(--section-y) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 620px;
    grid-template-rows: auto 1fr;
    align-items: start;
    column-gap: 96px;
  }

  .contact-copy {
    grid-column: 1;
    min-width: 0;
  }

  .contact-copy .eyebrow {
    font-size: 12px;
    letter-spacing: 2.5px;
  }

  .contact-copy h2 {
    margin-top: 20px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.05;
    color: var(--cream);
  }

  .contact-sub {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--sand);
  }

  .contact-details {
    list-style: none;
    margin-top: 48px;
    border-top: 1px solid rgba(246, 241, 231, 0.15);
  }

  .contact-details li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(246, 241, 231, 0.15);
  }

  .contact-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(246, 241, 231, 0.25);
    color: var(--sand-light);
  }

  .contact-details li > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 17px;
    color: var(--cream);
  }

  .contact-details a {
    color: inherit;
    text-decoration: none;
  }

  .contact-details a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--stone);
  }

  .contact-info {
    grid-column: 1;
  }

  .contact-form {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 48px;
    background: var(--cream);
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(30, 28, 20, 0.25);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .req {
    color: var(--clay);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0 16px;
    height: 50px;
    background: var(--cream-bright);
    border: 1px solid rgba(43, 42, 34, 0.2);
    border-radius: 4px;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group textarea {
    height: 160px;
    padding: 14px 16px;
    line-height: 1.5;
    resize: vertical;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #8a8575;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--clay);
    box-shadow: 0 0 0 3px rgba(194, 115, 74, 0.18);
  }

