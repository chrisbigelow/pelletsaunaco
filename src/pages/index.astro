<script>
  // Show only the poster for reduced-motion users and data-saver connections.
  const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (heroVideo && (window.matchMedia('(prefers-reduced-motion: reduce)').matches || connection?.saveData)) {
    heroVideo.removeAttribute('autoplay');
    heroVideo.pause();
    heroVideo.preload = 'none';
  }

  // Contact form submission
  const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submitLabel');
  const formMessage = document.getElementById('formMessage');

  // Links from the product page pass ?subject=… to pre-fill the form (e.g. pre-order reservations).
  const presetSubject = new URLSearchParams(window.location.search).get('subject');
  const subjectInput = document.getElementById('form_subject') as HTMLInputElement | null;
  if (presetSubject && subjectInput) subjectInput.value = presetSubject.slice(0, 120);

  const showMessage = (text: string, type: 'success' | 'error') => {
    if (!formMessage) return;
    formMessage.textContent = text;
    formMessage.className = `form-message ${type}`;
    formMessage.style.display = 'block';
  };

  const setSubmitting = (submitting: boolean) => {
    if (submitBtn) submitBtn.disabled = submitting;
    if (submitLabel) submitLabel.textContent = submitting ? 'Sending...' : 'Send Message';
  };

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    setSubmitting(true);
    if (formMessage) formMessage.style.display = 'none';

    try {
      const formData = new FormData(contactForm);

      // Spam protection: Check honeypot field
      if (formData.get('botcheck')) {
        showMessage('Spam detected. If you are human, please try again.', 'error');
        return;
      }

      // Add the subject from the form_subject field to the email subject
      const formSubject = formData.get('form_subject');
      if (formSubject) {
        formData.set('subject', `New Contact Form Submission: ${formSubject}`);
      }

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        showMessage('Thank you! Your message has been sent successfully.', 'success');
        contactForm.reset();
      } else {
        throw new Error(data.message || 'Something went wrong');
      }
    } catch (error) {
      showMessage('Sorry, there was an error sending your message. Please try again or contact us directly.', 'error');
    } finally {
      setSubmitting(false);
    }
  });
</script>
