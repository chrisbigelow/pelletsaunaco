---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CompareTable from '../components/CompareTable.astro';
import RitualSection from '../components/RitualSection.astro';
import InfoTip from '../components/InfoTip.astro';
import BatchProgress from '../components/BatchProgress.astro';
import { campaign, savings, balance, usd, reserveHref, founderPerks } from '../lib/campaign';
import '../styles/theme.css';

const questionHref = `/?subject=${encodeURIComponent('Question about the P1')}#contact`;

const photos = [
  // Photos by Liz Drevlow Photography.
  { src: '/images/p1/ld-front-chimney.jpg', alt: 'The P1 pellet sauna stove burning against a cedar sauna wall, chimney rising above, autumn trees behind', width: 1066, height: 1600 },
  { src: '/images/p1/ld-through-wall.jpg', alt: 'Side view of the P1 installed through a cedar sauna wall, hopper outside and stove inside', width: 1066, height: 1600 },
  { src: '/images/p1/ld-angle-sunset.jpg', alt: 'The P1 stove at an angle on a cedar deck with the sun setting through autumn trees', width: 1800, height: 1200 },
  { src: '/images/p1/ld-front-fire.jpg', alt: 'Front view of the P1 with a bright fire in the window', width: 1200, height: 1800 },
  { src: '/images/p1/ld-fire-glass.jpg', alt: 'Close-up of flames through the P1 firebox window', width: 1200, height: 1800 },
  { src: '/images/p1/ld-stones-top.jpg', alt: 'Sauna stones piled on top of the P1 stove', width: 1800, height: 1200 },
  { src: '/images/p1/ld-hopper-outside.jpg', alt: 'The P1 pellet hopper and chimney mounted on the outside of a cedar sauna wall', width: 1066, height: 1600 },
  { src: '/images/p1/ld-hopper-carry.jpg', alt: 'Carrying a bucket of pellets to the P1 hopper outside the sauna', width: 1800, height: 1200 },
];

const quickStats = [
  { value: '40 min', label: 'Heat-up', note: 'Measured from 17°C (63°F) to 80°C (176°F) in a 300 ft³ (8.5 m³) sauna.' },
  { value: '210–500 ft³', label: 'Room size' },
  { value: '110V', label: 'Standard outlet (Solar Compatible)' },
];

const assurances = [
  { icon: 'plug', text: 'Plugs into a standard 110V outlet, no electrician needed' },
  { icon: 'sun', text: 'Solar compatible with an off-the-shelf battery, inverter and solar panel' },
  { icon: 'smartphone', text: 'Remote start and temperature control from your phone' },
  { icon: 'leaf', text: 'Burns clean, low-cost wood pellets' },
  { icon: 'clock', text: '12–15 hours of runtime on a single hopper load' },
  { icon: 'flag-us', text: 'Made in Fergus Falls, Minnesota' },
] as const;

const perks = founderPerks;

const paymentSteps = [
  {
    title: 'Reserve today',
    body: `Lock in the founders’ price with a fully refundable ${usd(campaign.deposit)} deposit. Change your mind? Refund it yourself anytime on our refund page. No calls, no waiting.`,
  },
  {
    title: 'We build yours to order',
    body: 'Every P1 is built to order, not pulled from a warehouse. We’ll send you a build update every week along the way.',
  },
  {
    title: 'Balance at production',
    body: `Your remaining ${usd(balance)}, plus any shipping, isn’t charged until your stove goes into production in ${campaign.productionMonth}.`,
  },
];

const sides = [
  {
    tag: 'Outside',
    image: '/images/p1/ld-pellet-pour.jpg',
    alt: 'Pouring wood pellets from a bucket into the P1 hopper outside the sauna',
    title: 'A hopper you fill from the outside',
    body: 'Pour in a bag of pellets, close the lid, and you are ready to go. The steel hopper keeps fuel dry and the mess outdoors.',
  },
  {
    tag: 'Inside',
    image: '/images/p1/ld-stones-close.jpg',
    alt: 'Close-up of sauna stones loaded in the top of the P1',
    title: 'Set it once, stay as long as you like',
    body: 'The P1 feeds and burns pellets on its own, holding the hot room at exactly the temperature you choose. No stoking, just perfect temperature control.',
  },
];


const specs = [
  ['Heating Capacity', '210–500 ft³ (5.9–14.2 m³) sauna'],
  ['Wall Thickness', 'Fits 1.5–6.5 in (38–165 mm) sauna walls'],
  ['Fuel Type', 'Wood Pellets'],
  ['Hopper Capacity', '60 lbs (27 kg) of wood pellets'],
  ['Power Requirement', 'Standard 110V Outlet'],
  ['Material', 'Steel'],
  ['Dimensions (L×W×H)', '16.6 × 14.2 × 26.8 in<br/>422 × 360 × 680 mm'],
  ['Stone Weight', '110 lbs (50 kg)'],
  ['Warranty', '1 Year (electrical components)<br/>20 Years (steel body)'],
  ['Certification', 'Certification Pending'],
];
---

<BaseLayout
  title="P1 Pellet Sauna Stove Pre-Order | The Pellet Sauna Company"
  description="Reserve the P1 pellet sauna stove with $100 down. Founders' price $3,495 (save $500), plus a numbered build medallion and founders' community access."
  lcpImage={photos[0].src}
>
  <SiteNav solid variant="product" />

  <main class="pdp">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">P1 Pellet Sauna Stove</li>
      </ol>
    </nav>

    <!-- Product hero -->
    <section class="product-hero" id="p1">
      <div class="gallery" data-gallery>
        <div class="gallery-thumbs">
          {photos.map((photo, i) => (
            <button type="button" class="gallery-thumb" data-src={photo.src} data-alt={photo.alt} aria-label={`Show photo ${i + 1} of ${photos.length}`} aria-current={i === 0 ? 'true' : undefined}>
              <img src={photo.src} alt="" width={photo.width} height={photo.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </button>
          ))}
        </div>
        <div class="gallery-main">
          <img class="gallery-image" src={photos[0].src} alt={photos[0].alt} width={photos[0].width} height={photos[0].height} fetchpriority="high" />
          <div class="gallery-bar">
            <div class="gallery-arrows">
              <button type="button" class="gallery-arrow" data-step="-1" aria-label="Previous photo"><Icon name="arrow-left" size={16} /></button>
              <button type="button" class="gallery-arrow" data-step="1" aria-label="Next photo"><Icon name="arrow-right" size={16} /></button>
            </div>
            <span class="gallery-count" aria-live="polite">1 / {photos.length}</span>
          </div>
        </div>
      </div>

      <div class="buy-box">
        <div class="buy-head">
          <h1>P1 Pellet<br />Sauna Stove</h1>
        </div>
        <p class="buy-description">
          The P1 automatically feeds clean-burning wood pellets from an outside hopper into a steel firebox inside your sauna. Real fire, real stones, real löyly at the press of a button.
        </p>
        <dl class="quick-stats">
          {quickStats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}{'note' in stat && <InfoTip text={stat.note} label="About heat-up time" />}</dd>
            </div>
          ))}
        </dl>
        <div class="buy-price">
          <p class="buy-price-value">
            {usd(campaign.price)}
            <s class="full-price"><span class="visually-hidden">Regular price </span>{usd(campaign.fullPrice)}</s>
          </p>
          <p class="buy-price-save">Founders’ price for our first batch · Save {usd(savings)}</p>
          <p class="buy-price-note">
            Reserve with only <strong>{usd(campaign.deposit)} down today</strong>. Fully refundable.<br />
            The remaining balance is charged when production begins in {campaign.productionMonth}.
          </p>
          <BatchProgress size="compact" />
        </div>
        <div class="buy-actions">
          <a href={reserveHref} class="btn btn-clay">Reserve for {usd(campaign.deposit)} <Icon name="arrow-right" size={14} /></a>
          <a href={questionHref} class="btn btn-outline-ink">Ask a question</a>
        </div>
        <ul class="assurances">
          {assurances.map((item) => (
            <li><Icon name={item.icon} size={18} class="assurance-icon" />{item.text}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Pre-order campaign -->
    <section class="campaign" id="preorder">
      <div class="campaign-head">
        <h2>Help build<br />the first {campaign.batchSize}.</h2>
        <p>
          Every P1 is built to order with precision and care, not mass-produced or pulled from a warehouse. Reserve yours with {usd(campaign.deposit)} down.<br />
          The balance is only charged once your stove goes into production.
        </p>
      </div>

      <div class="founders-card">
        <div class="founders-price">
          <span class="founders-badge">Founders’ price</span>
          <p class="founders-price-row">
            <span class="founders-price-value">{usd(campaign.price)}</span>
            <s class="full-price"><span class="visually-hidden">Regular price </span>{usd(campaign.fullPrice)}</s>
          </p>
          <p class="founders-save">Founders’ price {usd(campaign.price)} for our first batch; {usd(campaign.fullPrice)} after.</p>
          <BatchProgress />
        </div>
        <div class="founders-pay">
          <dl class="founders-payment">
            <div><dt>Today</dt><dd>{usd(campaign.deposit)} down, fully refundable</dd></div>
            <div><dt>At production</dt><dd>{usd(balance)} + shipping</dd></div>
          </dl>
          <a href={reserveHref} class="btn btn-clay founders-cta">Reserve for {usd(campaign.deposit)} <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>

      <div class="campaign-details">
        <div>
          <p class="eyebrow">Included with every founders’ reservation</p>
          <ul class="detail-list">
            {perks.map((perk) => (
              <li>
                <span class="perk-icon"><Icon name={perk.icon} size={20} /></span>
                <div>
                  <h3>{perk.title}</h3>
                  <p>{perk.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow">How payment works</p>
          <ol class="detail-list">
            {paymentSteps.map((step, i) => (
              <li>
                <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Inside / outside -->
    <section class="sides" id="features">
      <div class="sides-head">
        <div>
          <p class="eyebrow">One stove, two sides of the wall</p>
          <h2>Fire inside.<br />Fuel outside.</h2>
        </div>
        <p>
          The P1 installs through your sauna wall. The hopper stays outside where pellets are easy to load, while the firebox and stones heat the room inside, with no fuel or wood dust in the hot room.
        </p>
      </div>
      <div class="sides-columns">
        {sides.map((side, i) => (
          <article class="side">
            <div class="side-photo">
              <img src={side.image} alt={side.alt} width="1200" height="1280" loading="lazy" decoding="async" />
              <span class="side-tag">{side.tag}</span>
            </div>
            <div class="side-copy">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{side.title}</h3>
                <p>{side.body}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>


    <RitualSection
      photo={{ src: '/images/p1/ld-through-wall.jpg', alt: 'Side view of the P1 installed through a cedar sauna wall, hopper outside and stove inside', width: 1066, height: 1600 }}
      caption={{ label: 'As shown', text: 'P1 installed through a cedar sauna wall' }}
    />

    <CompareTable />

    <!-- Specifications -->
    <section class="specs" id="specifications">
      <img
        class="specs-image"
        src="/images/home/p1-sketch.jpg"
        alt="Pencil sketch of the P1 pellet sauna stove"
        width="1352"
        height="784"
        loading="lazy"
        decoding="async"
      />
      <div class="specs-copy">
        <p class="eyebrow">Built to last, designed to perform</p>
        <h2 class="section-title">Technical<br />Specifications</h2>
        <dl class="spec-list">
          {specs.map(([label, value]) => (
            <div class="spec-row">
              <dt>{label}</dt>
              <dd set:html={value} />
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- FAQ link -->
    <section class="faq-link">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">Questions about the P1?</h2>
        <p>Heat-up time, room sizes, pellets, installation and maintenance: answers to the most common questions live on our FAQ.</p>
      </div>
      <a href="/#faq" class="btn btn-outline-ink">Read the FAQ <Icon name="arrow-right" size={14} /></a>
    </section>

    <!-- Final CTA -->
    <section class="final-cta">
      <img class="final-cta-bg" src="/images/p1/ld-sunset-wide.jpg" alt="" width="2000" height="1333" loading="lazy" decoding="async" />
      <div class="final-cta-copy">
        <p class="eyebrow">Now taking pre-orders</p>
        <h2>Reserve your P1.</h2>
        <p>Reserve with {usd(campaign.deposit)} down and lock in your founders’ price, numbered medallion, and community access. The balance is only charged when production begins. Currently available in the US and Canada only.</p>
        <div class="final-cta-actions">
          <a href={reserveHref} class="btn btn-clay">Reserve for {usd(campaign.deposit)} <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .pdp {
    padding-top: 65px;
  }

  @media (max-width: 640px) {
    .pdp {
      padding-top: 60px;
    }
  }

  @media (min-width: 1025px) {
    .pdp {
      --section-y: 96px;
    }
  }

  @media (min-width: 1201px) {
    .pdp {
      --gutter: max(96px, calc((100vw - 1088px) / 2));
    }
  }

  h1,
  h2,
  h3 {
    font-weight: 300;
  }

  .step-num {
    flex-shrink: 0;
    min-width: 24px;
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 300;
    color: var(--clay);
  }

  .btn-outline-ink {
    justify-content: center;
    border-color: var(--ink);
    color: var(--ink);
  }

  .btn-outline-ink:hover {
    background: var(--ink);
    color: var(--cream);
  }

  /* Breadcrumb */
  .breadcrumb {
    padding: 28px var(--gutter) 0;
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 12px;
    color: var(--stone);
  }

  .breadcrumb a {
    color: #8a8575;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--ink);
  }

  /* Product hero */
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(420px, 440px);
    gap: 64px;
    padding: 28px var(--gutter) var(--section-y);
  }

  .gallery {
    --gallery-max-h: max(480px, calc(100vh - 210px));
    display: flex;
    gap: 16px;
    align-self: start;
  }

  /* Never taller than the main photo: on short screens the strip scrolls. */
  .gallery-thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: var(--gallery-max-h);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .gallery-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery-thumb {
    flex-shrink: 0;
    width: 60px;
    aspect-ratio: 88 / 112;
    padding: 0;
    border: 1px solid rgba(43, 42, 34, 0.15);
    background: none;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .gallery-thumb:hover,
  .gallery-thumb[aria-current='true'] {
    opacity: 1;
  }

  .gallery-thumb[aria-current='true'] {
    border: 1.5px solid var(--ink);
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hug the photo so the arrows and counter sit on it, not below it. */
  .gallery-main {
    position: relative;
    flex: 1;
    min-width: 0;
    align-self: flex-start;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: var(--gallery-max-h);
    aspect-ratio: 600 / 760;
    object-fit: cover;
    background: var(--linen);
  }

  .gallery-bar {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gallery-arrows {
    display: flex;
    gap: 8px;
  }

  .gallery-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(246, 241, 231, 0.9);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .gallery-arrow:hover {
    background: var(--cream-bright);
  }

  .gallery-count {
    padding: 8px 12px;
    border-radius: 2px;
    background: rgba(30, 28, 20, 0.7);
    color: var(--cream);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
  }

  .buy-box {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 16px;
  }

  .buy-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .buy-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 3.6vw, 3rem);
    line-height: 1.04;
    color: var(--ink);
  }

  .buy-description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .quick-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    border-top: 1px solid rgba(43, 42, 34, 0.15);
    border-bottom: 1px solid rgba(43, 42, 34, 0.15);
  }

  .quick-stats div {
    display: flex;
    flex-direction: column-reverse;
    /* Pin values to the top so they line up when a label wraps */
    justify-content: flex-end;
    gap: 6px;
    padding: 16px;
  }

  .quick-stats div:first-child {
    padding-left: 0;
  }

  .quick-stats div + div {
    border-left: 1px solid rgba(43, 42, 34, 0.15);
  }

  .quick-stats dd {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--ink);
    white-space: nowrap;
  }

  .quick-stats dt,
  .buy-price-save {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a8575;
  }

  .buy-price {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .buy-price-save {
    color: var(--clay);
  }

  .buy-price-value {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 300;
    color: var(--ink);
  }

  .full-price {
    margin-left: 10px;
    font-size: 0.7em;
    color: #8a8575;
    white-space: nowrap;
  }

  .buy-price-note {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .buy-price-note strong {
    font-weight: 600;
    color: var(--ink);
  }

  .buy-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .buy-actions .btn {
    justify-content: center;
    padding: 17px 24px;
  }

  .assurances {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    padding-top: 4px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
  }

  .assurances li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .assurances :global(.assurance-icon) {
    flex-shrink: 0;
    color: var(--pine);
  }

  /* Pre-order campaign */
  .campaign {
    background: var(--linen);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .campaign-head,
  .sides-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
  }

  .sides-head > div {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .campaign-head h2,
  .sides-head h2 {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--ink);
  }

  .campaign-head > p,
  .sides-head > p {
    max-width: 440px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .founders-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding: 40px;
    border-radius: 2px;
    border: 1.5px solid var(--clay);
    background: var(--cream);
  }

  .founders-price {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .founders-badge {
    align-self: flex-start;
    padding: 6px 10px;
    border-radius: 2px;
    background: var(--clay);
    color: #fff;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .founders-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .founders-price-value {
    font-family: var(--serif);
    font-size: 56px;
    font-weight: 300;
    line-height: 1.1;
    color: var(--ink);
  }

  .founders-price-row .full-price {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 300;
  }

  .founders-save {
    font-size: 16px;
    color: var(--muted);
  }

  .founders-pay {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .founders-payment div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(43, 42, 34, 0.15);
    font-size: 15px;
  }

  .founders-payment dt {
    color: var(--muted);
  }

  .founders-payment dd {
    font-weight: 500;
    color: var(--ink);
    text-align: right;
  }

  .founders-cta {
    justify-content: center;
  }

  .campaign-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
