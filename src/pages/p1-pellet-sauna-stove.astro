<script>
  // Photo gallery: thumbnails, arrows and counter swap the main image.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  if (gallery) {
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('.gallery-thumb')];
    const mainImage = gallery.querySelector<HTMLImageElement>('.gallery-image');
    const count = gallery.querySelector('.gallery-count');
    let current = 0;

    const show = (index: number) => {
      current = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[current];
      if (mainImage) {
        mainImage.src = thumb.dataset.src ?? '';
        mainImage.alt = thumb.dataset.alt ?? '';
      }
      thumbs.forEach((t) => (t === thumb ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      if (count) count.textContent = `${current + 1} / ${thumbs.length}`;
    };

    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));
    gallery.querySelectorAll<HTMLButtonElement>('.gallery-arrow').forEach((arrow) =>
      arrow.addEventListener('click', () => show(current + Number(arrow.dataset.step)))
    );
  }

  // Countdown, shown once the campaign end date is set.
  document.querySelectorAll<HTMLElement>('[data-days-left]').forEach((el) => {
    const endsAt = el.dataset.daysLeft;
    if (!endsAt) return;
    const days = Math.ceil((new Date(`${endsAt}T23:59:59`).getTime() - Date.now()) / 86_400_000);
    el.textContent = days > 0 ? `${days} ${days === 1 ? 'day' : 'days'} left` : 'Campaign closed';
  });
</script>
